# Copy to .env and fill in. Never commit .env.

# Neo4j AuraDB (from the Aura console credentials file)
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# LLM providers
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=
GROQ_MODEL=
LLM_MAX_CALLS=

# GitHub REST API
GITHUB_TOKEN=

# Local Postgres (must match docker-compose.yml)
POSTGRES_DSN=
